# Commit-safe form (issue #1870): the liberty below is written relative
# to $PDK_ROOT, which Yosys does NOT expand -- this file is the artifact
# to commit, not the one to run. Run the rehydrated sibling
# 'synth_jpeg_codec_top.run.ys' (regenerated by every `klt synthesize` run), or
# substitute your own PDK install root for $PDK_ROOT first.
read_verilog rtl/jpeg_codec_top.v
read_verilog rtl/jc_sram_wrap.v
read_verilog rtl/jc_sram_arb.v
read_verilog rtl/jc_downsample.v
read_verilog rtl/jc_mb_ctrl.v
read_verilog rtl/colour_convert.v
read_verilog rtl/jc_dct.v
read_verilog rtl/jc_dct1d.v
read_verilog rtl/jc_xpose_rf.v
read_verilog rtl/jc_zigzag.v
read_verilog rtl/jc_quant.v
read_verilog rtl/jc_quant_core.v
read_verilog rtl/jc_huff.v
read_verilog rtl/jc_bitpack.v
read_verilog rtl/jc_cfg_regs.v
read_verilog rtl/jc_table_load.v
read_verilog rtl/jc_table_load_rom.v
read_verilog rtl/jc_header_gen.v
read_verilog rtl/jc_out_mux.v
read_verilog rtl/jc_qoi.v
read_verilog flow/sram_blackbox.v
hierarchy -check -top jpeg_codec_top
synth -top jpeg_codec_top
dfflibmap -liberty $PDK_ROOT/ciel/gf180mcu/versions/f6eeac7dad085ffcc829ccfd721f7b4ce39edcf7/gf180mcuD/libs.ref/gf180mcu_fd_sc_mcu9t5v0/lib/gf180mcu_fd_sc_mcu9t5v0__ss_125C_3v00.lib
tee -q -o flow/netlist/jpeg_codec_top_abc.log abc -liberty $PDK_ROOT/ciel/gf180mcu/versions/f6eeac7dad085ffcc829ccfd721f7b4ce39edcf7/gf180mcuD/libs.ref/gf180mcu_fd_sc_mcu9t5v0/lib/gf180mcu_fd_sc_mcu9t5v0__ss_125C_3v00.lib -constr flow/netlist/jpeg_codec_top_abc.constr -D 20000
clean
setundef -zero
hilomap -hicell gf180mcu_fd_sc_mcu9t5v0__tieh Z -locell gf180mcu_fd_sc_mcu9t5v0__tiel ZN
tee -q -o flow/netlist/jpeg_codec_top_stats.json stat -liberty $PDK_ROOT/ciel/gf180mcu/versions/f6eeac7dad085ffcc829ccfd721f7b4ce39edcf7/gf180mcuD/libs.ref/gf180mcu_fd_sc_mcu9t5v0/lib/gf180mcu_fd_sc_mcu9t5v0__ss_125C_3v00.lib -json -top jpeg_codec_top
write_verilog -noattr flow/netlist/jpeg_codec_top_synth.v
