# Source this file: `. flow/pdk.env`
# Exports the pinned PDK and refuses (returns/exits non-zero) when the resolved
# tree's open_pdks revision differs from the pin, so a stale tree such as an
# old ~/.volare install is never used silently.
# Pin recorded in spec/decision-records/0001-pdk-pin.md.

export PDK=gf180mcuD
export PDK_FAMILY=gf180mcu
export OPEN_PDKS_REV=f6eeac7dad085ffcc829ccfd721f7b4ce39edcf7
export CIEL_VERSION=2.6.1
export PDK_ROOT="${PDK_ROOT:-$HOME/.ciel}"

_pdk_env_fail() {
    echo "pdk.env: $*" >&2
    return 1 2>/dev/null || exit 1
}

_pdk_sources="$PDK_ROOT/$PDK/SOURCES"
if [ ! -f "$_pdk_sources" ]; then
    _pdk_env_fail "no SOURCES file at $_pdk_sources (install with: uvx --from ciel==$CIEL_VERSION ciel enable --pdk-family $PDK_FAMILY $OPEN_PDKS_REV)"
else
    _pdk_found=$(awk '$1 == "open_pdks" { print $2 }' "$_pdk_sources")
    if [ "$_pdk_found" != "$OPEN_PDKS_REV" ]; then
        _pdk_env_fail "open_pdks revision mismatch in $_pdk_sources: found '${_pdk_found:-<none>}', pinned $OPEN_PDKS_REV"
    fi
fi
_pdk_rc=$?
unset _pdk_sources _pdk_found
unset -f _pdk_env_fail
return $_pdk_rc 2>/dev/null || exit $_pdk_rc
